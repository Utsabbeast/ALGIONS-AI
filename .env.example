# Django Configuration
DJANGO_SECRET_KEY=your-secure-django-secret-key-change-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Relational Database Configuration
# Optional: Set DATABASE_URL for PostgreSQL on Render; defaults to sqlite:///db.sqlite3 locally
# DATABASE_URL=postgres://user:password@hostname:5432/cinemabox

# NoSQL Persistence (MongoDB)
# Optional: Set MONGODB_URI to connect to MongoDB Atlas; defaults to resilient embedded JSON Document Store if omitted
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_NAME=cinemabox_nosql

